# Jekyll / Ruby build
.bundle/
.jekyll-cache/
.jekyll-metadata
.sass-cache/
_site/
# vendor/ = bundle install --path vendor
vendor/

# Node / Pagefind tooling (commit package.json + lockfile, not the deps)
node_modules/
.pagefind-cache/

# Brajeshwar's local work queue for Claude Code (see CLAUDE.md). It is an inbox
# of what to do next, not a record of the site — the durable record is _docs/.
# Ignored so a half-written idea never reaches a commit or the deployed site.
CLAUDE.local.md

# Editor / tooling local state
.claude/
.impeccable/
.obsidian/
.ruby-lsp/
.idea/

# Scratch — local braindumps & working files (not part of the site)
tmp/

# Ignore OS generated files #
.DS_Store*
ehthumbs.db
Thumbs.db

# Ignore packages #
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Always-ignore these #
*.diff
*.err
*.log
*.orig
*.rej
*.swn
*.swo
*.swp
._*
*~

# ---- Design sources — NEVER commit these -------------------------------
# Affinity/Photoshop/Sketch working files are hundreds of MB and are not what
# the site ships; the site ships the exported asset.
#
# Added 2026-07-27 after a 166 MB .afphoto reached a commit and blocked the
# push outright: GitHub rejects any file over 100 MB, and it rejects it on the
# BLOB, so deleting the file in a later commit does not help — the blob is
# still in the history being pushed. Un-doing it meant rewriting history.
#
# Keep the sources somewhere outside the repo (or in Git LFS, if they ever
# genuinely need versioning).
*.afphoto
*.afdesign
*.afpub
*.psd
*.sketch
*.fig
*.xd
